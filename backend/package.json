{
  "name": "unicircle-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build --silent && node --test dist/tests/constants.test.js dist/tests/auth.test.js dist/tests/listings.test.js dist/tests/requests.test.js dist/tests/admin.test.js",
    "test:auth": "npm run build --silent && node --test dist/tests/auth.test.js",
    "test:auth:integration": "npm run build --silent && node --test dist/tests/integration/phase-2-auth.test.js",
    "test:listings": "npm run build --silent && node --test dist/tests/listings.test.js",
    "test:listings:integration": "npm run build --silent && node --test dist/tests/integration/phase-3-listings.test.js",
    "test:requests": "npm run build --silent && node --test dist/tests/requests.test.js",
    "test:requests:integration": "npm run build --silent && node --test dist/tests/integration/phase-4-requests.test.js",
    "test:admin": "npm run build --silent && node --test dist/tests/admin.test.js",
    "test:admin:integration": "npm run build --silent && node --test dist/tests/integration/phase-5-admin.test.js",
    "test": "npm run build --silent && node --test dist/tests/constants.test.js dist/tests/integration/phase-1-migration.test.js",
    "migrate": "npm run build --silent && node dist/src/migrations/run.js",
    "photos:cleanup": "npm run build --silent && node dist/src/jobs/cleanup-orphan-photos.js",
    "admin:provision": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/provision-admin.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.19.1",
    "nodemailer": "^10.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
